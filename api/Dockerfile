# The API image: the Go binary, the campaign templates, and the mayor list.
#
# It serves JSON and nothing else — the interface has an image of its own,
# which proxies /api here. The application is STATELESS: accounts, statuses
# and notes live in PostgreSQL (PARAPHE_DATABASE_URL, given at deployment).
# No volume.
#
# Built from the repository root, because the mayor list and the templates
# are shared with the mass mailing and live outside api/.

FROM golang:1.26-alpine AS binary
WORKDIR /src
COPY api/go.mod api/go.sum ./
RUN go mod download
COPY api/ ./
# static: the final image has no libc to offer
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /paraphe-api .

FROM alpine:3.22
RUN adduser -S -u 10001 -h /srv/paraphe paraphe
WORKDIR /srv/paraphe

COPY --from=binary /paraphe-api /usr/local/bin/paraphe-api
COPY config/ config/
COPY modeles/ modeles/
# generated by `task build`: the image embeds the mayor list of the moment.
# 04 is the one the application serves; 01 feeds the mass mailing.
COPY out/04_base_complete.csv out/04_base_complete.csv
COPY out/01_maires_cibles_prioritaires.csv out/01_maires_cibles_prioritaires.csv

# No interface to serve here. Left empty rather than removed: `task api`
# still serves a locally built web/dist for development, and pointing this
# at nothing is what tells the binary there is none.
ENV PARAPHE_WEB_DIR=""
ENV PARAPHE_HOST=0.0.0.0 \
    PARAPHE_PORT=8047
EXPOSE 8047

USER 10001
ENTRYPOINT ["paraphe-api"]
