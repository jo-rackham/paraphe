# What must NEVER enter an image: the team's work and the secrets.
#
# Docker's "*" does NOT cross a "/", unlike .gitignore's: without the "**/",
# app/data.sqlite entered the build context and the CI cache.
**/*.sqlite*
**/*.sql
**/*.db
**/*.dump
app/
.env
.env.*
!.env.exemple
config/campagne.local.yaml

# Raw sources: only the built lists go into the image.
data/
out/messages/
out/02_anciens_parrains.csv
out/03_non_apparies.csv
out/rapport.md

# Host build artefacts. Copied in, they collide with what the stages build
# (pnpm refuses to start on a node_modules it did not install itself) and
# they carry binaries compiled for another platform.
#
# api/vendor is NOT here, and that is the point: it is committed, and the
# build stage uses it instead of downloading modules.
node_modules/
web/node_modules/
outils/node_modules/
web/dist/
web/public/donnees/
api/paraphe-api
api/api

# Not part of the application: transferring them costs build time and
# invalidates the context for nothing.
e2e/
chart/
.github/
.plans/
.claude/
.gh-*/
.repos/
.git/
.venv/
.devbox/
.playwright-mcp/
.pytest_cache/
__pycache__/
tests/
