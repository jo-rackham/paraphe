# Copier en .env (ignoré par git) et remplir. C'est ICI que vivent les
# valeurs réelles : ni docker-compose.yml ni config/campagne.yaml, qui sont
# versionnés et partiraient dans le dépôt public.
#
#   cp .env.exemple .env && ${EDITOR:-nano} .env

# --- Secrets (obligatoires) ---------------------------------------------
# Compte de coordination, créé au premier démarrage.
PARAPHE_ADMIN_EMAIL=coordination@exemple.fr
PARAPHE_ADMIN_PASSWORD=
PARAPHE_ADMIN_NAME=Coordination

# Signature des sessions (JWT HS512) : openssl rand -hex 64
# Laisser vide en mono-instance (l'app en tire un et le conserve en base) ;
# obligatoire dès qu'il y a plusieurs instances.
PARAPHE_SECRET_KEY=

# --- Campagne ------------------------------------------------------------
PARAPHE_CANDIDATE=
PARAPHE_CANDIDATE_DESCRIPTION=
PARAPHE_CANDIDATE_DESCRIPTION_LONG=
PARAPHE_SIGNATORY=
PARAPHE_SIGNATORY_ROLE=
PARAPHE_CONTACT_PHONE=
PARAPHE_CONTACT_EMAIL=
PARAPHE_SITE=
PARAPHE_SENDING_CITY=

# Mot de passe de la base locale (docker compose). openssl rand -hex 16
PARAPHE_PG_PASSWORD=

# Mot de passe de Valkey (compteurs du rate-limiting). openssl rand -hex 24
PARAPHE_VALKEY_PASSWORD=

# --- Logo des campagnes (facultatif) --------------------------------------
# Le logo d'une campagne est servi par un stockage objet, sur une origine à
# lui. Tout laisser vide = pas de logo : l'en-tête garde l'hexagone seul et
# l'écran « Mon équipe » le dit. C'est tout ou rien — un stockage à moitié
# configuré, c'est une campagne qui téléverse un logo que personne n'affiche.
#
# Le compose lance un nœud Garage ; le chart en lance trois. Sur un cloud,
# pointer ces variables sur l'object store du fournisseur et ne rien héberger.
#
# Secret RPC du nœud Garage (compose uniquement) : openssl rand -hex 32
PARAPHE_GARAGE_RPC_SECRET=
# Jeton d'administration de Garage, utilisé par l'amorçage (création du seau,
# import de la clé). Non publié hors du réseau du compose. openssl rand -hex 32
PARAPHE_GARAGE_ADMIN_TOKEN=
# Identifiants S3. Le compose IMPORTE cette paire dans Garage au démarrage,
# donc ce sont ces valeurs qui font foi. L'ID commence par GK (Garage le
# veut ainsi) ; le secret : openssl rand -hex 32
PARAPHE_MEDIA_ACCESS_KEY=GKparaphelocal0000000000
PARAPHE_MEDIA_SECRET_KEY=
# Origine PUBLIQUE d'où le navigateur télécharge les logos — pas l'adresse
# interne que l'application utilise pour écrire. C'est elle que la
# Content-Security-Policy autorise, et une valeur fausse se voit uniquement
# dans la console du navigateur, sous la forme d'une image qui n'arrive pas.
# En local, *.localhost résout vers la boucle locale dans tout navigateur.
PARAPHE_MEDIA_PUBLIC_URL=http://paraphe-media.media.localhost:3902

# --- Plusieurs campagnes sur la même instance -----------------------------
# Vide = UNE campagne, tout nom d'hôte la sert (le mode par défaut).
# Renseigné = chaque campagne sur <campagne>.<domaine>, l'apex servant
# l'accueil public et la modération. Exige alors :
#   - un DNS générique *.<domaine> et un certificat générique (DNS-01) ;
#   - un rôle PostgreSQL SANS privilège : un superutilisateur traverse le
#     cloisonnement, et l'app refuse de démarrer dans ce cas.
PARAPHE_BASE_DOMAIN=
# Sous-domaine de la campagne décrite ci-dessus
PARAPHE_ORG_SLUG=campagne
# Administration de l'instance : valide les demandes d'hébergement, et ne lit
# aucune donnée de campagne. Requis dès que PARAPHE_BASE_DOMAIN est rempli.
PARAPHE_INSTANCE_ADMIN_EMAIL=
PARAPHE_INSTANCE_ADMIN_PASSWORD=
PARAPHE_INSTANCE_ADMIN_NAME=Administration

# --- Connexion par email (facultatif) ------------------------------------
# Vide : personne ne reçoit de lien, et l'écran de connexion ne le propose
# pas — le mot de passe reste le seul chemin, comme avant.
# Renseigné : « Recevoir un lien par email » apparaît, et ouvrir un accès
# envoie une invitation au lieu de faire dicter un mot de passe au téléphone.
#
# Relais SMTP. Le mot de passe se met dans la variable d'à côté, JAMAIS dans
# l'URL : une URL se retrouve dans les logs et dans un `describe pod`.
#   smtp://utilisateur@relais.exemple.fr:587   (STARTTLS, le cas courant)
#   smtps://utilisateur@relais.exemple.fr:465  (TLS dès le premier octet)
PARAPHE_SMTP_URL=
PARAPHE_SMTP_PASSWORD=
# Expéditeur affiché. « Campagne <contact@exemple.fr> » ou une adresse seule.
PARAPHE_MAIL_FROM=
# L'origine que les liens de ces emails désignent. Obligatoire dès que
# PARAPHE_SMTP_URL est rempli, et jamais déduite de l'en-tête Host : n'importe
# qui peut le poser, et le lien partirait alors vers le serveur de son choix.
# Multi-campagne : l'apex (https://paraphe.org), le sous-domaine s'ajoute seul.
PARAPHE_PUBLIC_URL=

# --- Exploitation --------------------------------------------------------
# Vide : la coordination règle la taille de lot dans l'application. Une
# valeur ici est réappliquée à chaque redémarrage et écrase la sienne.
PARAPHE_BATCH_SIZE=
# affiche « code source » en pied de page
PARAPHE_SOURCE_URL=
# URL de la version navigateur (sans compte) proposée sur l'accueil de
# l'instance. L'image la sert elle-même sous /navigateur/ et le lien
# apparaît tout seul — ne renseigner que pour pointer ailleurs.
PARAPHE_BROWSER_VERSION_URL=
# Niveau de log : debug, info, warn ou error. Vide = info.
PARAPHE_LOG_LEVEL=

# Les réseaux dont le X-Forwarded-For est cru par le rate-limiting
# (PARAPHE_TRUSTED_PROXIES) ne se règlent PAS ici : le compose les pose
# lui-même dans son bloc `environment`, qui gagne sur ce fichier. Hors
# Docker, les passer à l'application directement — sans eux, tout le monde
# partage un seul compteur derrière le proxy.
