# Copier en .env (ignoré par git) et remplir. C'est ICI que vivent les
# valeurs réelles : ni docker-compose.yml ni config/campagne.yaml, qui sont
# versionnés et partiraient dans le dépôt public.
#
#   cp .env.exemple .env && ${EDITOR:-nano} .env

# --- Secrets (obligatoires) ---------------------------------------------
# Compte de coordination, créé au premier démarrage.
PARAPHE_ADMIN_EMAIL=coordination@exemple.fr
PARAPHE_ADMIN_PASSWORD=
PARAPHE_ADMIN_NAME=Coordination

# Signature des sessions (JWT HS512) : openssl rand -hex 64
# Laisser vide en mono-instance (l'app en tire un et le conserve en base) ;
# obligatoire dès qu'il y a plusieurs instances.
PARAPHE_SECRET_KEY=

# --- Campagne ------------------------------------------------------------
PARAPHE_CANDIDATE=
PARAPHE_CANDIDATE_DESCRIPTION=
PARAPHE_CANDIDATE_DESCRIPTION_LONG=
PARAPHE_SIGNATORY=
PARAPHE_SIGNATORY_ROLE=
PARAPHE_CONTACT_PHONE=
PARAPHE_CONTACT_EMAIL=
PARAPHE_SITE=
PARAPHE_SENDING_CITY=

# Mot de passe de la base locale (docker compose). openssl rand -hex 16
PARAPHE_PG_PASSWORD=

# Mot de passe de Valkey (compteurs du rate-limiting). openssl rand -hex 24
PARAPHE_VALKEY_PASSWORD=

# --- Plusieurs campagnes sur la même instance -----------------------------
# Vide = UNE campagne, tout nom d'hôte la sert (le mode par défaut).
# Renseigné = chaque campagne sur <campagne>.<domaine>, l'apex servant
# l'accueil public et la modération. Exige alors :
#   - un DNS générique *.<domaine> et un certificat générique (DNS-01) ;
#   - un rôle PostgreSQL SANS privilège : un superutilisateur traverse le
#     cloisonnement, et l'app refuse de démarrer dans ce cas.
PARAPHE_BASE_DOMAIN=
# Sous-domaine de la campagne décrite ci-dessus
PARAPHE_ORG_SLUG=campagne
# Administration de l'instance : valide les demandes d'hébergement, et ne lit
# aucune donnée de campagne. Requis dès que PARAPHE_BASE_DOMAIN est rempli.
PARAPHE_INSTANCE_ADMIN_EMAIL=
PARAPHE_INSTANCE_ADMIN_PASSWORD=
PARAPHE_INSTANCE_ADMIN_NAME=Administration

# --- Exploitation --------------------------------------------------------
# Vide : la coordination règle la taille de lot dans l'application. Une
# valeur ici est réappliquée à chaque redémarrage et écrase la sienne.
PARAPHE_BATCH_SIZE=
# affiche « code source » en pied de page
PARAPHE_SOURCE_URL=
# Réseaux (CIDR, séparés par des virgules) dont le X-Forwarded-For est cru
# par le rate-limiting. À renseigner avec l'adresse de VOTRE proxy TLS :
# vide, chaque requête est attribuée à son pair TCP — derrière un proxy,
# tout le monde partage alors le même compteur. Avec le compose de ce dépôt
# le proxy tourne sur l'hôte et arrive par la passerelle Docker :
#   PARAPHE_TRUSTED_PROXIES=172.16.0.0/12
PARAPHE_TRUSTED_PROXIES=
